# Contract hashes must survive Windows checkouts and release builds.
asset/models/GeneratedAssetfiles/models/*.almond.json text eol=lf
asset/models/GeneratedAssetfiles/models/*.glb binary
# Generated drawing hashes cover original bytes (including DXF/SVG line endings).
asset/drawing/Draftingfiles/pilot/** -text whitespace=cr-at-eol
asset/drawing/Draftingfiles/pilot/**/*.dxf -diff linguist-generated=true
asset/drawing/Draftingfiles/pilot/**/*.svg linguist-generated=true
# Preserve the vendored upstream bundle and its recorded integrity on checkout.
src/rhp/Asset_Panel/web/vendor/** -text whitespace=cr-at-eol linguist-vendored=true
src/rhp/Asset_Panel/web/vendor/model-viewer.min.js -diff
