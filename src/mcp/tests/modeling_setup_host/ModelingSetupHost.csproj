<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RhinoSystem Condition="'$(RhinoSystem)' == ''">C:\Program Files\Rhino 8\System</RhinoSystem>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystem)\RhinoCommon.dll</HintPath><Private>true</Private></Reference>
    <Compile Include="../../features/modeling/native/DocumentLayers.cs" Link="DocumentLayers.cs" />
    <Compile Include="../../features/context/native/ObjectObservation.Dictionary.cs" Link="ObjectObservation.Dictionary.cs" />
    <Compile Include="../../rhino/ModelingMaterials.cs" Link="ModelingMaterials.cs" />
    <Compile Include="../../rhino/ModelingMetadata.cs" Link="ModelingMetadata.cs" />
    <EmbeddedResource Include="../../modeling_policy.json" LogicalName="RhinoAlmondBridge.modeling_policy.json" />
  </ItemGroup>
</Project>
