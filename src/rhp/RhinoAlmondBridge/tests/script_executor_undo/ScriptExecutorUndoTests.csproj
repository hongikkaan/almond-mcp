<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AlmondScriptUndoTests</AssemblyName>
    <RhinoSystem Condition="'$(RhinoSystem)' == ''">C:\Program Files\Rhino 8\System</RhinoSystem>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ObservationFixtureHost.cs" />
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystem)\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RhinoWindows"><HintPath>$(RhinoSystem)\RhinoWindows.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eto"><HintPath>$(RhinoSystem)\Eto.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rhino.UI"><HintPath>$(RhinoSystem)\Rhino.UI.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="../../ScriptExecutor.cs" Link="ScriptExecutor.cs" />
    <Compile Include="../../ManagedFiles.cs" Link="ManagedFiles.cs" />
    <Compile Include="../../../../mcp/rhino/ModelingMaterials.cs" Link="ModelingMaterials.cs" />
    <Compile Include="../../../../mcp/rhino/ModelingMetadata.cs" Link="ModelingMetadata.cs" />
    <Compile Include="../../../../mcp/features/context/native/*.cs" Link="Context/%(Filename)%(Extension)" />
    <Compile Include="../../../../mcp/features/components/native/*.cs" Link="Components/%(Filename)%(Extension)" />
    <Compile Include="../../../../mcp/features/modeling/native/*.cs" Link="Modeling/%(Filename)%(Extension)" />
    <Compile Include="../../../../mcp/features/drawings/native/*.cs" Link="Drawings/%(Filename)%(Extension)" />
    <Compile Include="../../../../mcp/features/assets/native/*.cs" Link="Assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../../mcp/modeling_policy.json" LogicalName="RhinoAlmondBridge.modeling_policy.json" />
  </ItemGroup>
</Project>
