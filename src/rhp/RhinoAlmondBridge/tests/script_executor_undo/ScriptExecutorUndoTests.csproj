<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AlmondScriptUndoTests</AssemblyName>
    <RhinoSystem Condition="'$(RhinoSystem)' == ''">C:\Program Files\Rhino 8\System</RhinoSystem>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystem)\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eto"><HintPath>$(RhinoSystem)\Eto.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rhino.UI"><HintPath>$(RhinoSystem)\Rhino.UI.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="../../ScriptExecutor.cs" Link="ScriptExecutor.cs" />
    <Compile Include="../../DocumentObservation.cs" Link="DocumentObservation.cs" />
    <Compile Include="../../ManagedFiles.cs" Link="ManagedFiles.cs" />
    <Compile Include="../../DocumentLayers.cs" Link="DocumentLayers.cs" />
    <Compile Include="../../../../mcp/almond_mcp/rhino/ModelingMaterials.cs" Link="ModelingMaterials.cs" />
    <Compile Include="../../../../mcp/almond_mcp/rhino/ModelingMetadata.cs" Link="ModelingMetadata.cs" />
    <Compile Include="../../ComponentRegistry.cs" Link="ComponentRegistry.cs" />
    <Compile Include="../../DrawingSheetRegistry.cs" Link="DrawingSheetRegistry.cs" />
    <Compile Include="../../ComponentOperations.cs" Link="ComponentOperations.cs" />
    <Compile Include="../../DrawingAssetGeometry.cs" Link="DrawingAssetGeometry.cs" />
    <Compile Include="../../../Asset_Panel/FurnitureAssetManager.cs" Link="FurnitureAssetManager.cs" />
    <Compile Include="../../Probes/*.cs" Link="Probes/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../../mcp/almond_mcp/modeling_policy.json" LogicalName="RhinoAlmondBridge.modeling_policy.json" />
  </ItemGroup>
</Project>
