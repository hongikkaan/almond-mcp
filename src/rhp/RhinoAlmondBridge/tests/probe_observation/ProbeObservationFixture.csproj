    <Compile Include="Program.cs" />
    <Compile Include="NativeTests.cs" />
    <Compile Include="../../Probes/*.cs" Link="Helpers\%(Filename)%(Extension)" />
    <Compile Include="../../ProbeObservation.cs" Link="ProbeObservation.cs" />
  </ItemGroup>
</Project>
