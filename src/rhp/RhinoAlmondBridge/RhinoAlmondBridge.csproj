<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Title>RhinoAlmondBridge</Title>
    <Description>MCP Bridge plugin for Rhino - receives and executes C# RhinoCommon scripts from AI agents</Description>
    <Version>0.7.0-rc.2</Version>
    <!-- Keep the informational version equal to Version so yak's manifest
         check doesn't see the +gitsha suffix SourceLink appends. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>RhinoAlmondBridge</RootNamespace>
    <AssemblyName>RhinoAlmondBridge</AssemblyName>
    <RhinoSystem Condition="'$(RhinoSystem)' == ''">C:\Program Files\Rhino 8\System</RhinoSystem>
    <GrasshopperSystem Condition="'$(GrasshopperSystem)' == ''">$(RhinoSystem)\..\Plug-ins\Grasshopper</GrasshopperSystem>
  </PropertyGroup>

  <ItemGroup>
    <!-- Match the installed Rhino SDK used by Almond.Engine and the Terminal web view. -->
    <Reference Include="RhinoCommon"><HintPath>$(RhinoSystem)\RhinoCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eto"><HintPath>$(RhinoSystem)\Eto.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rhino.UI"><HintPath>$(RhinoSystem)\Rhino.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Grasshopper"><HintPath>$(GrasshopperSystem)\Grasshopper.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GH_IO"><HintPath>$(GrasshopperSystem)\GH_IO.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Include="../../mcp/almond_mcp/rhino/*.cs" Link="Modeling\%(Filename)%(Extension)" />
    <Compile Include="../Structural_Analysis/*.cs" />
    <Compile Include="../Asset_Panel/*.cs" />
    <Compile Include="../RhinoTerminal/src/*.cs" />
    <ProjectReference Include="../Engine/Almond.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../mcp/almond_mcp/modeling_policy.json" LogicalName="RhinoAlmondBridge.modeling_policy.json" />
    <!-- Panel tab icons: Almond and Almond Results -->
    <EmbeddedResource Include="Resources\*.ico" />
    <EmbeddedResource Include="../RhinoTerminal/src/web/terminal.html" LogicalName="RhinoTerminal.terminal.html" />
    <EmbeddedResource Include="../RhinoTerminal/src/web/xterm.js" LogicalName="RhinoTerminal.xterm.js" />
    <EmbeddedResource Include="../RhinoTerminal/src/web/xterm.css" LogicalName="RhinoTerminal.xterm.css" />
    <EmbeddedResource Include="../RhinoTerminal/src/web/addon-fit.js" LogicalName="RhinoTerminal.addon-fit.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
  </ItemGroup>

</Project>
