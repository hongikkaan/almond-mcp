<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Commands.cs" Link="Commands.cs" />
    <Compile Include="../../src/TerminalPanel.cs" Link="TerminalPanel.cs" />
    <Compile Include="../../src/TerminalRuntime.cs" Link="TerminalRuntime.cs" Condition="Exists('../../src/TerminalRuntime.cs')" />
    <EmbeddedResource Include="../../src/web/*" LogicalName="RhinoTerminal.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
